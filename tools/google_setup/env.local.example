# Copy to .env.local in this folder (gitignored).

# Same GCP JSON key for GA4 Admin API + Google Ads API
# GA4_SERVICE_ACCOUNT_JSON=C:/path/to/your-key.json

# Google Ads API Center (required for status / export-env / run Ads steps)
# GOOGLE_ADS_DEVELOPER_TOKEN=

# Optional: MCC login customer ID
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
