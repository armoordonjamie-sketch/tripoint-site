# Production Vite env (build-time). Not committed.
#
# Server: copy to .env.production here, OR /var/www/tripoint/config/frontend.env (deploy copies before build).
# Vite exposes only vars prefixed with VITE_.

VITE_GA4_MEASUREMENT_ID=G-TE618HYTQ2
# Google Ads tag + contact conversion (full send_to from Ads > Conversions > tag setup)
VITE_GOOGLE_ADS_MEASUREMENT_ID=AW-17966741863
# Example: AW-17966741863/AbCdEfGhIjK
VITE_GOOGLE_ADS_CONVERSION_SEND_TO=

# "Should I Buy This Car?" experiment - affiliate history-check partner link shown on the
# thank-you page. Optional: if unset, a clearly-marked placeholder URL is used (replace before launch).
VITE_AFFILIATE_HISTORY_CHECK_URL=
