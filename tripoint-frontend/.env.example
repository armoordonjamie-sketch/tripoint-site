# Copy to .env.local for local dev (not committed). Vite exposes only vars prefixed with VITE_.
# Production: tripoint-frontend/.env.production.example or config/frontend.env.example

# GA4 - Admin → Data streams → Web
VITE_GA4_MEASUREMENT_ID=G-M8NGL90Z1R

# Google Ads - tag ID (AW-…)
VITE_GOOGLE_ADS_ID=AW-17966741863

# --- Google Ads conversion labels (only the part AFTER AW-XXXXX/) ---
# Each *conversion action* in Ads → Goals → Conversions has its own label. Paste one label per line.
# Do NOT paste the same label everywhere unless you only have one action and accept inflated counts.
# Leave a line empty to skip that Ads conversion (code may fall back for booking/WhatsApp - see src/lib/analytics.ts).

VITE_GOOGLE_ADS_CONV_WHATSAPP=
VITE_GOOGLE_ADS_CONV_EMAIL=
VITE_GOOGLE_ADS_CONV_PHONE=
VITE_GOOGLE_ADS_CONV_CONTACT=

VITE_GOOGLE_ADS_CONV_BOOKING_AVAILABILITY=
VITE_GOOGLE_ADS_CONV_BOOKING_SLOT=
VITE_GOOGLE_ADS_CONV_PAYMENT=

# Primary booking / confirmed - label you already use in Ads
VITE_GOOGLE_ADS_CONV_BOOKING=cJwYCL_clPwbEOfymvdC

VITE_GOOGLE_ADS_CONV_BOOK_NOW=
