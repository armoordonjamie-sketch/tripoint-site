# TriPoint backend env - EXAMPLE (no secrets). Real values live in python-scripts/.env (gitignored).
#
# The "Should I Buy This Car?" verdict experiment REUSES the email + Stripe config already
# present in .env - it adds no new provider. Those existing vars are (do not duplicate here):
#
#   Email (Zoho SMTP) : ZOHO_SMTP_HOST, ZOHO_SMTP_PORT, ZOHO_SMTP_USER, ZOHO_SMTP_PASS, ZOHO_FROM_EMAIL
#   Stripe            : STRIPE_SECRET_KEY, SITE_URL   (optional: STRIPE_SUCCESS_URL_BASE)
#   Notifications     : NOTIFY_EMAIL
#
# ── New / optional vars introduced by the verdict experiment ──────────────────────────────

# Where verdict notifications (free + paid PRIORITY) are sent.
# Falls back to NOTIFY_EMAIL, then contact@tripointdiagnostics.co.uk.
ADMIN_NOTIFY_EMAIL=

# Price of the Priority Verdict in pence. Defaults to 700 (£7.00) if unset.
VERDICT_PRIORITY_PRICE_PENCE=700
