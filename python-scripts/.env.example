# Google Sheets lead logging (POST /leads/track)
# Share the spreadsheet with the service account email from your JSON key (Editor).
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_LEADS_TAB=Leads
# Same service account as Calendar, or set file path:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# On the VPS use a Linux path (e.g. /var/www/tripoint/python-scripts/google-service-account.json), not a Windows dev path.
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/sa.json
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json

# Optional: open spreadsheet from admin Leads tab
# GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/YOUR_ID/edit

# Google Ads offline conversion export defaults (admin /admin/leads/google-ads/*)
# GOOGLE_ADS_QUALIFIED_CONVERSION_NAME=Qualified Lead
# GOOGLE_ADS_WON_CONVERSION_NAME=Won Job
# GOOGLE_ADS_DEFAULT_CURRENCY=GBP
# GOOGLE_ADS_DEFAULT_QUALIFIED_VALUE=50
# GOOGLE_ADS_DEFAULT_WON_VALUE=200

# GA4 Measurement Protocol — admin qualification events (lead_qualified / lead_disqualified / lead_won)
# BOTH vars are required to send events. Without GA4_API_SECRET, nothing is POSTed to Google (sheet save still works).
# Create the secret: GA4 Admin > Data streams > your Web stream > Measurement Protocol API secrets > Create.
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# GA4_API_SECRET=paste_secret_here
